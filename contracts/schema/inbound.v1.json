{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boi.app/schema/inbound.v1.json",
  "title": "Inbound v1 \u2014 normalized webhook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "provider_message_id",
    "line_id",
    "from_handle",
    "received_at",
    "kind"
  ],
  "properties": {
    "schema_version": {
      "const": "inbound.v1"
    },
    "provider": {
      "enum": [
        "linq",
        "mock",
        "twilio"
      ]
    },
    "provider_message_id": {
      "type": "string"
    },
    "line_id": {
      "type": "string"
    },
    "from_handle": {
      "type": "string",
      "description": "E.164 phone or email"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "null until pairing resolves it"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "text",
        "tapback",
        "read_receipt",
        "delivery_receipt",
        "typing"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "tapback": {
      "type": [
        "string",
        "null"
      ]
    },
    "reply_to_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol": {
      "enum": [
        null,
        "imessage",
        "rcs",
        "sms"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
