{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boi.app/schema/outbound.v1.json",
  "title": "Outbound v1 \u2014 provider-agnostic send payload",
  "description": "No provider semantics appear above the Channel interface. The composer emits blocks and never learns whether delivery was blue, green or grey.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_id",
    "idempotency_key",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": "outbound.v1"
    },
    "user_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "url"
            ],
            "properties": {
              "type": {
                "const": "image"
              },
              "url": {
                "type": "string"
              },
              "alt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name",
              "handle"
            ],
            "properties": {
              "type": {
                "const": "contact_card"
              },
              "name": {
                "type": "string"
              },
              "handle": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "reply_to_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "tapbacks",
          "images",
          "groups",
          "typing",
          "richlinks",
          "contact_cards",
          "threading"
        ]
      },
      "description": "Advisory. Negotiate via capabilities(); degrade silently, never assume."
    }
  }
}
