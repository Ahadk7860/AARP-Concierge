{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boi.app/schema/voice_pack.v1.json",
  "title": "Voice pack v1 \u2014 T1.5",
  "description": "THE USER'S OWN SENT MESSAGES ONLY. Every exemplar must come from a row where is_from_me = 1. A single inbound message here makes every privacy claim in BOI_ARCHITECTURE.md section 6 false. Exemplars are redacted before serialization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "voice_pack_version",
    "contact_id",
    "scope",
    "register",
    "exemplars",
    "as_of"
  ],
  "properties": {
    "schema_version": {
      "const": "voice_pack.v1"
    },
    "voice_pack_version": {
      "type": "string",
      "pattern": "^vp_[0-9a-f]{8,16}$",
      "description": "content hash. Changes invalidate the drafter prompt cache."
    },
    "contact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^h_[0-9a-f]{8,32}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "null means this is the user's global fallback pack"
    },
    "scope": {
      "enum": [
        "contact",
        "global"
      ]
    },
    "n_exemplars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median_len_chars",
        "emoji_rate",
        "punctuation",
        "avg_msgs_per_burst"
      ],
      "properties": {
        "median_len_chars": {
          "type": "integer",
          "minimum": 1
        },
        "p90_len_chars": {
          "type": "integer",
          "minimum": 1
        },
        "emoji_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top_emoji": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5
        },
        "punctuation": {
          "enum": [
            "lowercase_no_period",
            "lowercase_period",
            "sentence_case_no_period",
            "sentence_case_period",
            "mixed"
          ]
        },
        "greeting_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "signoff_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "abbreviations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "avg_msgs_per_burst": {
          "type": "number",
          "minimum": 1
        },
        "question_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "apology_openers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5
        }
      }
    },
    "exemplars": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": "REDACTED sent messages. No phone numbers, emails, street addresses, dollar amounts, or third-party full names."
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    }
  }
}
