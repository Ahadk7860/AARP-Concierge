{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boi.app/schema/brief.v1.json",
  "title": "Brief v1 \u2014 the composed daily message",
  "description": "Capped at three items. Twenty is noise; three is a habit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_id",
    "scheduled_for",
    "staleness",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "brief.v1"
    },
    "user_id": {
      "type": "string"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "staleness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_as_of",
        "hours_stale",
        "warn"
      ],
      "properties": {
        "digest_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "hours_stale": {
          "type": "number",
          "minimum": 0
        },
        "warn": {
          "type": "boolean"
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. 'Haven't seen your Mac since Sunday, so this is as of then.'"
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contact_id",
          "display",
          "headline",
          "gist",
          "remedy",
          "drafts"
        ],
        "properties": {
          "contact_id": {
            "type": "string",
            "pattern": "^h_[0-9a-f]{8,32}$"
          },
          "display": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "maxLength": 120,
            "description": "invitation, never verdict. 'you've reached out 12 times this month' not 'she doesn't text you back'."
          },
          "gist": {
            "type": "string",
            "maxLength": 140
          },
          "remedy": {
            "enum": [
              "reply",
              "call",
              "dismiss",
              "snooze"
            ],
            "description": "every reveal ships with a one-tap remedy. Never a verdict without an action."
          },
          "drafts": {
            "oneOf": [
              {
                "$ref": "draft_bundle.v1.json"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "card_url": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
