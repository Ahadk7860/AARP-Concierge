{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://boi.app/schema/voice_pack.v2.json",
  "title": "Voice pack v2 — contextual user-authored exemplars", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "voice_pack_version", "contact_id", "scope", "register", "exemplars", "as_of"],
  "properties": {
    "schema_version": {"const": "voice_pack.v2"}, "voice_pack_version": {"type": "string", "pattern": "^vp_[0-9a-f]{8,16}$"},
    "contact_id": {"oneOf": [{"type": "string", "pattern": "^h_[0-9a-f]{8,32}$"}, {"type": "null"}]}, "scope": {"enum": ["contact", "global"]},
    "n_exemplars": {"type": "integer", "minimum": 0, "maximum": 40}, "register": {"$ref": "voice_pack.v1.json#/properties/register"},
    "exemplars": {"type": "array", "maxItems": 40, "items": {"type": "object", "additionalProperties": false, "required": ["text", "answered", "register"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 200}, "answered": {"enum": ["question_from_them", "statement_from_them", "plan_unresolved", "none"]}, "register": {"enum": ["casual", "warm", "terse", "formal", "mixed"]}}}},
    "as_of": {"type": "string", "format": "date-time"}
  }
}
