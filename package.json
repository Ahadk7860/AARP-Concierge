{
  "name": "boi-imessage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Boi \u2014 the assistant that reads the room. Cloud half.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixtures": "python3 scripts/validate_fixtures.py",
    "chatdb": "python3 scripts/make_synthetic_chatdb.py",
    "test:c": "vitest run cloud/channel cloud/mock-linq",
    "test:d": "vitest run cloud/api cloud/brief cloud/card cloud/db",
    "lint:py": "ruff check intelligence && ruff format --check intelligence"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.17.1",
    "eslint": "^9.0.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fastify": "^5.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "undici": "^6.19.0",
    "zod": "^3.23.0"
  }
}
