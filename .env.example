# Every variable named in prompts/CONTRACTS.md. Copy to .env inside YOUR worktree —
# worktrees share neither untracked files nor installed dependencies.
#
# Ports and database names differ per track. Use the values assigned to YOUR track in
# CONTRACTS.md section 9. Do not use a framework default: another track may pick it too.

# ---- all tracks ----
BOI_ENV=development
BOI_BASE=main

# ---- shared by Tracks A and B: contact_id must agree across the Swift and Python
#      implementations, so the DEV salt is fixed and identical in both. The real salt
#      arrives from POST /v1/pair and is never this value.
BOI_DEV_USER_SALT=boi-dev-salt-do-not-ship-0001

# ---- Track A: Mac ----
BOI_FIXTURE_CHATDB=/tmp/boi-fixtures/chat.db
BOI_MAC_OUT_DIR=/tmp/boi-a/out
BOI_API_BASE=http://localhost:3041

# ---- Track B: intelligence ----
BOI_MODEL_PROVIDER=fake            # fake | gemini | kimi
BOI_PROMPT_VERSION=draft.v1
# Track B is the ONLY track permitted live model calls. Tests default to the
# FakeProvider; live calls require BOI_ALLOW_LIVE_CALLS=1 as well as a key.
BOI_ALLOW_LIVE_CALLS=0
GEMINI_API_KEY=
# Pin a concrete version, never the moving `gemini-flash-lite-latest` alias — prompt 05
# is a bake-off and an alias that shifts makes the evidence unreproducible.
# gemini-2.5-flash-lite is RETIRED for new API keys: it still appears in models.list()
# but a real request returns 404 NOT_FOUND. Only a live call detects that.
GEMINI_MODEL=gemini-3.5-flash-lite
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
BOI_LOCAL_GIST_MODEL=              # empty means SQL-only gists, which is the shipped fallback

# ---- Track C: transport ----
# CANONICAL: the base URL INCLUDES the /api/partner/v3 prefix. Adapters concatenate
# "/chats" onto it and nothing else. The mock serves that prefix and only that prefix --
# serving both readings would let an adapter built against the wrong base pass every
# test and 404 on the first live send, which is the exact discrepancy the mock exists to
# surface. Production is a one-value swap to https://api.linqapp.com/api/partner/v3
LINQ_BASE_URL=http://localhost:3031/api/partner/v3
LINQ_API_TOKEN=                          # not provisioned yet; rep-issued, not self-serve
LINQ_FROM_HANDLE=+15550100123
LINQ_WEBHOOK_SECRET=dev-secret-change-me
MOCK_LINQ_PORT=3031
MOCK_LINQ_MODE=up                        # up | degraded | banned | ratelimited
CHANNEL_TEST_PORT=3032
# Which line carried a send. The documented POST /chats 200 response has no line field,
# but the frozen SendResult requires line_id, so the adapter falls back to this. See
# "Contract gaps" in prompts/track-c-transport/NOTES.md.
LINQ_LINE_ID=line_a1
# Rate limiting. Real Linq limits are unknown (CONTRACTS section 11 item 3), so these are
# deliberately conservative and live here rather than in code: the sales-call answer is a
# .env change. 30/60s is far above one brief per user per day and far below anything that
# reads as automation.
CHANNEL_RATE_LIMIT_MAX=30
CHANNEL_RATE_LIMIT_INTERVAL_MS=60000
CHANNEL_RATE_LIMIT_BEHAVIOUR=delay       # delay | reject
CHANNEL_REQUEST_TIMEOUT_MS=10000
# Capability overrides, "key=bool" comma-separated, e.g. "groups=1,threading=0".
# Empty means the adapter's defaults. There is no capabilities endpoint in the Linq
# subset, so every value is a guess that config can correct without a code change.
# Only groups, images, contact_cards and threading gate a code path today; tapbacks,
# richlinks and typing are declared to match the frozen Capabilities type and currently
# gate nothing.
CHANNEL_CAPABILITIES=
# Line assignment and health. Every value here stands in for an unanswered sales-call
# question (CONTRACTS section 11 items 4-7), and every default is the PESSIMISTIC reading
# -- the assumption that costs least if it turns out to be wrong.
LINE_POOL=line_a1=+15550100123        # line_id=handle, comma-separated
LINE_USERS_PER_LINE=5                 # item 7: tenants per line unknown; assume shared.
                                      # Cost is linear in lines; ban risk is super-linear
                                      # in users per line. Keep this low.
LINE_STICKY=true                      # item 5: assume a line is NOT sticky indefinitely,
                                      # so rotation is a first-class migration event
LINE_ASSUME_ROTATION_NOTICE=false     # item 6: assume we are NOT told before a rotation
LINE_BAN_COVERED_BY_SLA=false         # item 4: assume the 99.95% SLA does NOT cover a
                                      # line-level Apple ID ban
LINE_DEGRADE_ON=banned                # which line states send over the fallback instead
LINE_HEALTH_POLL_INTERVAL_MS=60000
LINE_INTRODUCTION_TEXT=               # empty uses the default "new number" preamble

# ---- Track D: product surface ----
API_PORT=3041
CARD_PORT=3042
DATABASE_URL=postgres://localhost:5432/boi_dev_d
BOI_USER_SALT_PEPPER=dev-pepper-change-me
BOI_BRIEF_MAX_ITEMS=3
BOI_STALENESS_WARN_HOURS=24
BOI_STALENESS_SKIP_HOURS=168        # beyond this the morning send is skipped entirely
